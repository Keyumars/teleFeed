09F87A6F09F87B7.png\u0026#39;)\"\u003e\u003cb\u003e🇦🇷\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e از همان سوت آغاز مشخص بود که هیچکدام حاضر نیستند ریسک کنند. آرژانتین مالکیت بیشتری داشت، انگلیس فضاها را می‌بست و هر دو تیم بیشتر از اینکه به گل فکر کنند، به اشتباه نکردن فکر می‌کردند.\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"4990449417505997741\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B5.png\u0026#39;)\"\u003e\u003cb\u003e🔵\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e جالب اینکه مجموع xG دو تیم در نیمه اول فقط 0.08 بود؛ کمترین xG ثبت‌شده در نیمه اول یک بازی مرحله حذفی جام جهانی از زمان ثبت آمار (1966)\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"4990184005706974101\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E280BC.png\u0026#39;)\"\u003e\u003cb\u003e‼️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e این یعنی هر دو مربی تقریباً موفق شده بودند مهم‌ترین مهره‌های حریف را از بازی خارج کنند.\u003cbr/\u003e\u003cbr/\u003e\u003cblockquote\u003e\u003ctg-emoji emoji-id=\"5899979020983870583\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29ABD.png\u0026#39;)\"\u003e\u003cb\u003e⚽️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e‌ ‌ ‌‌ ‌ ‌گل گوردون؛ نقطه‌ای که بازی تغییر کرد\u003c/blockquote\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"4990182601252668309\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e دقیقه 55، حرکت سریع انگلیس و گل آنتونی گوردون. تا اینجا، همه چیز مطابق برنامه توماس توخل پیش میرفت. اما بزرگ‌ترین اشتباه انگلیس، بعد از گل شروع شد.\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5420323339723881652\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29AA0.png\u0026#39;)\"\u003e\u003cb\u003e⚠️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e به‌جای ادامه پرس و حفظ مالکیت، انگلیس عقب نشست و به دفاع از نتیجه فکر کرد. در 37 دقیقه پایانی، مالکیت انگلیس فقط 12 درصد بود. در واقع، انگلیس توپ را عملاً به آرژانتین هدیه داد.\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"4990008204105614578\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29780.png\u0026#39;)\"\u003e\u003cb\u003e◀️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e اسکالونی منتظر همین لحظه بود؛ برخلاف بسیاری از مربیان، اسکالونی بعد از عقب افتادن عجله نکرد. تعویض‌های او ساختار تیم را هجومی‌تر کرد، اما تعادل حفظ شد. ورود لائوتارو مارتینز، حضور بیشتر انزو در اطراف محوطه و آزادی کامل مسی، فشار آرژانتین را دقیقه‌به‌دقیقه بیشتر کرد.\u003cbr/\u003e\u003cbr/\u003e\u003cblockquote\u003e\u003ctg-emoji emoji-id=\"5222141780476046109\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9090.png\u0026#39;)\"\u003e\u003cb\u003e🐐\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e‌ ‌ ‌‌ ‌ ‌مسی؛ بدون گل، اما تعیین‌کننده\u003c/blockquote\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"4990108972628313185\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B5.png\u0026#39;)\"\u003e\u003cb\u003e🔵\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e شاید نام او روی تابلو گلزنان نبود، اما تقریباً تمام حملات خطرناک آرژانتین از شماره 10 عبور می‌کرد. او مدام بین خطوط حرکت کرد، مدافعان انگلیس را از جای خود بیرون کشید و در نهایت هم پاس گل پیروزی را برای لائوتارو فرستاد. این همان تفاوت یک بازیکن بزرگ با یک اسطوره است؛ حتی وقتی گل نمیزند، نتیجه مسابقه را تغییر میدهد.\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5846097402125099642\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F87A6F09F87B7.png\u0026#39;)\"\u003e\u003cb\u003e🇦🇷\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"4943124435591758525\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09FA4AF.png\u0026#39;)\"\u003e\u003cb\u003e🤯\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e امید صعود کمتر از 2 درصد؛ طبق مدل‌های لحظه‌ای احتمال برد، تا حوالی دقیقه 82 شانس صعود آرژانتین به زیر 2 درصد رسیده بود. اما این تیم، پیش از این هم بارها ثابت کرده بود که تا آخرین سوت زنده می‌ماند.\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5456140674028019486\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29AA1.png\u0026#39;)\"\u003e\u003cb\u003e⚡️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e گل انزو فرناندز در دقیقه 85، همه چیز را برگرداند. و در وقت‌های تلف‌شده، ارسال دقیق مسی و ضربه لائوتارو، تیر خلاص را شلیک کرد.\u003cbr/\u003e\u003cbr/\u003e\u003cblockquote\u003e\u003ctg-emoji emoji-id=\"5314504236132747481\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E28189.png\u0026#39;)\"\u003e\u003cb\u003e⁉️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5846207842914148361\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8FB4F3A081A7F3A081A2F3A081A5F3A081AEF3A081A7F3A081BF.png\u0026#39;)\"\u003e\u003cb\u003e🏴󠁧󠁢󠁥󠁮󠁧󠁿\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e‌ ‌ ‌‌ ‌ ‌حالا میرسیم به این سوال که چرا انگلیس حذف شد؟\u003c/blockquote\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"4990476089252906260\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29780.png\u0026#39;)\"\u003e\u003cb\u003e◀️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e توماس توخل بعد از گل، به‌جای ادامه حمله، تیمش را عقب کشید. هری کین هم بعد از بازی اعتراف کرد که انگلیس بیش از حد روی حفظ نتیجه تمرکز کرد و همین باعث حذف شد. وقتی مقابل آرژانتین فقط دفاع میکنی، در واقع به مسی فرصت میدهی تا راهی برای شکستت پیدا کند.\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"4990449417505997741\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B5.png\u0026#39;)\"\u003e\u003cb\u003e🔵\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e آرژانتین تیم دقیقه‌های آخر؛ اگر فکر میکنید این فقط یک اتفاق بود، دوباره نگاه کنید. در مرحله حذفی این جام، 55 درصد گل‌های آرژانتین بعد از دقیقه 90 و 82% آنها بعد از دقیقه 78 به ثمر رسیده است. میانگین زمان گلهای این تیم در مراحل حذفی، دقیقه 82 بوده. این آمار فقط کیفیت را نشان نمیدهد؛ شخصیت و باور یک تیم را هم نشان میدهد.\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5231012545799666522\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F948D.png\u0026#39;)\"\u003e\u003cb\u003e🔍\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e جمع‌بندی؛ این مسابقه را فقط مسی نبرد. اسکالونی هم برد. او صبور ماند، بازی را کنترل کرد، زمان تعویض‌ها را درست انتخاب کرد و تا آخرین دقیقه به برنامه‌اش وفادار ماند.\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5271604874419647061\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9497.png\u0026#39;)\"\u003e\u003cb\u003e🔗\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e در طرف مقابل، انگلیس بعد از گل، از بردن بازی دست کشید و فقط به نباختن فکر کرد. و در فوتبال، مخصوصاً مقابل آرژانتینِ اسکالونی و مسی، فاصله بین «بردن» و «فقط دفاع کردن» گاهی فقط 10 دقیقه است.\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5271604874419647061\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9497.png\u0026#39;)\"\u003e\u003cb\u003e🔗\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e همین 10 دقیقه، آرژانتین را برای دومین جام جهانی متوالی به فینال رساند؛ و بار دیگر ثابت کرد که این تیم، تا زمانی که سوت پایان به صدا درنیاید، هرگز تسلیم نمیشود.\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5951774084600700473\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u00