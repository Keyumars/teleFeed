    {
      "id": 0,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eخسروپناه، دبیر شورای عالی انقلاب فرهنگی :\u003cbr/\u003eتصمیم شورا بر اینه که حق اونایی که خوندن ضایع نشه، پس تاثیر معدل یازدهم قطعی میمونه.\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cblockquote\u003eعمده دانش آموزان نظرشون اینه که تاثیر یازدهم قطعی بمونه چون پارسال واسش زحمت کشیدن، حتی شماره منو پیدا کردن و کلی بهم بابتش زنگ زدن که توروخدا نذار مثبت بشه.\u003cbr/\u003e\u003c/blockquote\u003e\u003cblockquote\u003eمیگن جنگه ولی این جنگ ربطی به امسالی‌ها نداره، پارسال نهایی یازدهم برگزار شده.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eآموزش و پرورش بره ترمیم تک درس رو بیاره؛ چون تاثیر یازدهم قطعی می‌مونه.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eاینایی که اومدن تجمع، بیشترشون پشت کنکوری هستن!\u003c/blockquote\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DrTeL\" target=\"_blank\"\u003e@DrTeL\u003c/a\u003e",
