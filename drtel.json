      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eچند روز پیش یه بلاگر خانم اومد با مداحیِ \u0026#34;بریم نجف\u0026#34; یه ویدیو گرفت؛\u003cbr/\u003e\u003cblockquote\u003eاول همه فکر کردن قراره بره کربلا ولی ورداشت غذا درست کرد و بین سگ و گربه‌ها پخش کرد.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eاین ویدیو خیلی وایرال شد و به تعداد زیادی از افراد مذهبی‌ برخورد و این ویدئو رو توهین به امام علی دونستن...\u003c/blockquote\u003e\u003cbr/\u003eپلیس هم امشب پیج این خانم رو بست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DrTeL\" target=\"_blank\"\u003e@DrTeL\u003c/a\u003e",
