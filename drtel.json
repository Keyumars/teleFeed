      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eحرف‌های عجیب و ترامپ گونه ظهرهوند، عضو کمیسیون امنیت ملی مجلس: \u003cbr/\u003e\u003cblockquote\u003eاینجا دو ثانیه دیگه تهرانه، سه ثانیه دیگه مثلا واشینگتنه. \u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eمیشه کارهایی کرد که اصلا بمب اتمی یعنی چی؟ این‌ها دیگه بچه‌بازی و واسه گذشته‌ست.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eمن جاهایی رو که دیدم، ظرفیت‌هایی رو که دیدم، اتفاقاتی میفته که بمب اتم واقعا پیشش ترقه‌ست.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eمیشه کارهای عجیبی کرد. میشه زمان رو پشت سر گذاشت. یعنی چی؟ هیچکس نمی‌دونه!\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eشاید کارهایی رو انجام بدیم که بمب اتم پیشش ترقه باشه.\u003c/blockquote\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DrTeL\" target=\"_blank\"\u003e@DrTeL\u003c/a\u003e",
