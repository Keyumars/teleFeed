    {
      "id": 0,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eخرازی، دبیرکل حزب‌الله ایران :\u003cbr/\u003e\u003cbr/\u003eاگه پزشکیان یک بار دیگه استعفا بده، مجتبی خامنه‌ای موافقت می‌کنه\u003c/b\u003e.\u003cbr/\u003e\u003cblockquote\u003eمسعود پزشکیان تا حالا نزدیک به 28 بار یا استعفا داده یا تهدید به استعفا کرده!\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eقراره ذوالقدر رو از دبیرکلی شورای عالی امنیت ملی دربیاره و محسن رضایی رو جاش بذاره.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eمجتبی به عراقچی هم گفته دیگه به هیچ عنوان حق دخالت تو مذاکرات رو نداری.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eهمه اینا همیشه تهدید به استعفا میکردن ولی از وقتی مجتبی خامنه‌ای تهدید کرده، دیگه فیتیله‌ها رو پایین کشیدن.\u003c/blockquote\u003e\u003cbr/\u003e\u003cb\u003eماشالله مجتبی خامنه‌ای خیلی سفت و بی‌تعارفه ، پدرش یکم تعارف داشت.\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DrTeL\" target=\"_blank\"\u003e@DrTeL\u003c/a\u003e",
