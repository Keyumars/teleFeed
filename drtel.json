      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eترامپ به فاکس‌نیوز:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eاین می‌تونه بزرگ‌ترین معامله تاریخ باشه؛ \u003c/b\u003e\u003cbr/\u003e\u003cblockquote\u003eاونا ممکنه پرچم سفید تسلیم رو بالا بدن.  بگن: تسلیم شدیم، تسلیم شدیم، تمومه، دیگه تموم شد.\u003cbr/\u003eایالات متحده بزرگ‌ترین قدرت دنیاست. الحمدلله.\u003cbr/\u003e\u003c/blockquote\u003e\u003cblockquote\u003eاونا می‌تونن همه این حرف‌ها رو بزنن، بلند و واضح. ولی رسانه‌های فیک نیوز بازم می‌گن این پیروزی بزرگی برای ایران بوده! واقعاً دیوونگیه، عجیب‌ترین چیزیه که دیدم.\u003cbr/\u003e\u003c/blockquote\u003e\u003cblockquote\u003eما داريم اونا رو له می‌کنیم.هواپیماهای ما بالای تهران پرواز می‌کنن و اونا حتی خبر ندارن ما اونجاییم.\u003cbr/\u003eاز موشک‌هاشون هم احتمالاً کمتر از 20% براشون مونده.\u003cbr/\u003e\u003c/blockquote\u003e\u003cb\u003eترجیح من همیشه این بوده که جزیره خارک رو بگیریم؛\u003c/b\u003e\u003cbr/\u003e\u003cblockquote\u003eراستش رو بخوای، نمی‌دونم آمریکا حوصله و تحملش رو داره یا نه. ولی اگه بگیریم، کلی پول درمیاریم.\u003cbr/\u003eمطمئن نیستم آمریکا حوصله یه فرآیند طولانی رو داشته باشه. ولی اگه بخوام، این کار تضمین‌شده‌ست.\u003cbr/\u003e\u003c/blockquote\u003e‌\u003cbr/\u003e\u003ca href=\"https://t.me/DrTeL\" target=\"_blank\"\u003e@DrTeL\u003c/a\u003e",
