    {
      "id": 0,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eخبرگزاری فارس :\u003cbr/\u003eخبر آکسیوس درباره توافق ایران و آمریکا برای پایان جنگ فعلاً درست نیست و هنوز هیچ تفاهم جدیدی نهایی نشده؛\u003cbr/\u003e\u003cbr/\u003eهنوز پیام مکتوب تازه‌ای بین دو طرف رد و بدل نشده و ایران هم هنوز به آخرین پیام آمریکا جواب نداده.\u003cbr/\u003e\u003cblockquote\u003eخبرهایی که آکسیوس و رویترز منتشر کردن بیشتر شبیه فضاسازی رسانه‌ایه تا واقعیت قطعی؛ مخصوصاً برای اینکه قیمت نفت پایین بیاد و روی بازار و افکار عمومی آمریکا اثر بذارن.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eایران قبلاً یه پیشنهاد 14 ماده‌ای واسه پایان جنگ از طریق پاکستان به آمریکا فرستاده و الان پاسخ آمریکایی‌ها داره بررسی میشه.\u003cbr/\u003eآکسیوس بعضی وقتا خواسته‌های آمریکا رو به شکل خبر منتشر می‌کنه و این خبرها شاید مقدمه دور جدید مذاکرات باشه.\u003c/blockquote\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DrTeL\" target=\"_blank\"\u003e@DrTeL\u003c/a\u003e",
