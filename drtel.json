      "id": 0,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e\u003cb\u003eمرادویسی، تحلیلگر اینترنشنال:\u003cbr/\u003eفروپاشی راهبردهای نظامی سپاه که ثابت شده توهم بودن؛\u003c/b\u003e\u003cbr/\u003e\u003cblockquote\u003eاینکه میگفتن ما با حملات موشکی انبوه میتونیم سامانه‌های دفاعی اسراییل رو از بین ببریم و نتونستن.\u003cbr/\u003e\u003c/blockquote\u003e\u003cblockquote\u003eاینکه سردارهای سپاه میگفتن میتونیم تل‌آویو و حیفا رو با خاک یکسان کنیم و نتونستن.\u003cbr/\u003e\u003c/blockquote\u003e\u003cblockquote\u003eاینکه میگفتن با حملات انبوه قایق‌های تندرو میتونیم به ناوهای آمریکا حمله کنیم و غرقشون کنیم و نتونستن.\u003cbr/\u003e\u003c/blockquote\u003e\u003cblockquote\u003eاینکه میگفتن موشک‌های نقطه‌زن بالستیک داریم که باهاشون میتونیم ناوهای هواپیمابر آمریکا رو غرق کنیم و نتونستن.\u003cbr/\u003e\u003c/blockquote\u003e\u003cblockquote\u003eاینکه میگفتن رادارهایی داریم که هواپیماهای آمریکا و اسرائیل رو که از پایگاه‌هاشون بلند میشن میتونن رصد کنن، سامانه‌های پدافندی قدرتمندی داریم و مدافعان آسمان ولایت هستیم و اجازه‌ی ورود هیچ هواپیمایی رو به آسمون ایران نمیدیم، ثابت شد دروغ بوده.\u003c/blockquote\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DrTeL\" target=\"_blank\"\u003e@DrTeL\u003c/a\u003e",
