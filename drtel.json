    {
      "id": 0,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eنجمه امینی، دختر 23 ساله‌ای که تو اعتراضات دی‌ماه مشهد دستگیر شده بود :\u003cbr/\u003e\u003cbr/\u003e\u003cblockquote\u003eحکم اعدام من صادر شده، صدای من باشید، من یه جوون بی‌گناه با کلی آرزو و رویا هستم.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eمن فقط عدالت و فرصت دفاع می‌خوام.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eاز سازمان‌های بین‌المللی می‌خوام پرونده من رو بررسی و پیگیری کنن.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eتا وقتی زنده هستم یه امید دارم اونم اینه که بتونم ایرانِ آباد و آزادم رو ببینم.\u003c/blockquote\u003e\u003cbr/\u003e\u003cbr/\u003e+ خبرگزاری فارس :\u003cbr/\u003e \u003cbr/\u003e\u003cblockquote\u003eنجمه امینی به اتهام توهین به مقدسات و سب‌النبی تو فضای مجازی و فعالیت علیه امنیت ملی تو اعتراضات دی‌ماهِ مشهد بازداشت شده.\u003cbr/\u003e\u003c/blockquote\u003e\u003cblockquote\u003eهنوز هیچ حکم قطعی واسه خانم امينی صادر نشده.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eهدف از انتشار این صوت، تهییج دانشجوها قبل شروع سال تحصیلی جدیده.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eهنوز معلوم نیست اصلا این صدا متعلق به‌این خانم هست یا نه...\u003c/blockquote\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DrTeL\" target=\"_blank\"\u003e@DrTeL\u003c/a\u003e",
