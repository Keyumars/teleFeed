    {
      "id": 0,
      "message": "\u003cb\u003e\u003ctg-emoji emoji-id=\"5399997355455961843\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F87AEF09F87B7.png\u0026#39;)\"\u003e\u003cb\u003e🇮🇷\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003c/b\u003e\u003cb\u003e ذوالقدر، دبیر شورای عالی امنیت ملی:\u003cbr/\u003e\u003cbr/\u003eتا آمریکا خودش رو طبق موارد زیر اصلاح نکنه، تنگه هرمز باز نمیشه!\u003c/b\u003e\u003cbr/\u003e\u003cblockquote\u003eایران رو هرگز تهدید و به مقدسات مردم توهین نکنه.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eبه جنگ و تجاوز علیه ایران و متحدان ایران تو لبنان، فلسطين، یمن و عراق واسه همیشه پایان بده.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eمحاصره دریایی رو برداره و نیروهای نظامیِ دریایی و هواییش رو از اطراف ایران خارج کنه. \u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eخسارت‌هایی که تو این دوتا جنگ به ایران زده رو تا قرون آخر پرداخت کنه.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eهمه تحریم‌های ایران رو برداره.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eپول‌های بلوکه شده مردم ایران رو آزاد کنه.\u003c/blockquote\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DrTeL\" target=\"_blank\"\u003e@DrTeL\u003c/a\u003e",
