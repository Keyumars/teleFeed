      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eوضعيت فعلی تنگه هرمز این شکلیه؛\u003cbr/\u003e\u003cbr/\u003eاول کار که باید 20 درصد به ترامپ حق نگهبانی بدی، تازه اگه مربوط به ایران باشه کلا حق نداری بری یا بیای..\u003cbr/\u003e\u003cblockquote\u003eحالا اگه کشتی از بالای تنگه (سمت ایران) بره، آمریکا منفجرش می‌کنه.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eاگه از طرف پایین تنگه (سمت عمان) بره، ایران منفجرش میکنه.\u003c/blockquote\u003e\u003cbr/\u003eتهشم به خودشون میان می‌بینن با قایق نجات دارن برمیگردن خونه...\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DrTeL\" target=\"_blank\"\u003e@DrTeL\u003c/a\u003e",
