    {
      "id": 0,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e لانا رودز، بازیگر سابق فیلم‌های پورن : \u003cbr/\u003e\u003cbr/\u003eراستش دیگه نمی‌خوام اون ویدیوهای قدیمی ازم تو اینترنت باشن، الان که مادر شدم، بیشتر از هر چیزی نگران اینم که یه روز پسرم اون‌ ویدیوها رو ببینه؛\u003cbr/\u003e\u003cblockquote\u003eدوست دارم همه اون محتواها از گوشی مردم پاک بشن، اون موقع تصمیم‌های دیگه‌ای گرفته بودم، ولی الان فقط می‌خوام زندگی فعلیم و خانواده‌م رو داشته باشم و گذشته‌م مدام جلوم سبز نشه.\u003c/blockquote\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DrTeL\" target=\"_blank\"\u003e@DrTeL\u003c/a\u003e | ladbible",
