      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eترانه علیدوستی درباره پرونده تجاوزِ پژمان جمشیدی:\u003c/b\u003e\u003cbr/\u003e\u003cblockquote\u003eدلیل اصلی که انقدر این اتفاق تو سینما می‌افته، امنیتِ مطلق مردهاست!\u003c/blockquote\u003e\u003cbr/\u003e\u003cbr/\u003e+ \u003cb\u003eملیکا پارسادوست، شاکی :\u003c/b\u003e\u003cbr/\u003e\u003cblockquote\u003eاحساس میکنم بدهکار هم شدم.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eوقتی تو خونه پژمان جمشیدی به من داشت تجاوز میشد، یه نفر سوم هم اونجا بود.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eتو راه پزشکی قانونی بیهوش شدم، دلم میخواست فقط برم حموم ولی خب نمیشد.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eاونجا فقط پرده بکارت من رو چک کردن و کاری به حالم و کبودی‌های روی بدنم نداشتن.\u003c/blockquote\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DrTeL\" target=\"_blank\"\u003e@DrTeL\u003c/a\u003e",
