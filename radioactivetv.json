    {
      "id": 0,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e 10 نشونه از آدمای سمی:\u003cbr/\u003e\u003cblockquote\u003eهر کاری بکنین، هیچوقت براشون کافی نیست!\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eاز قصد روی کوچیک‌ترین نقطه ضعف و نقص شما دست میذارن.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eمدام گذشته‌تون رو پیش میکشن و اجازه نمیدن پیشرفت کنین!\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eیه طوری رفتار میکنن انگار خودشون هیچوقت اشتباه نمی کنن!\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eباعث میشن دائما احساس گناه کنین.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eکنترلگر هستن و به نیازهای شما توجه نمی کنن.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eبعد از ارتباط با اونا احساس میکنین از نظر روحی ضربه دیدین.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eخط قرمزهای شمارو زیر پا میذارن و طاقت شنیدن «نه» رو ندارن!\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eاحساسات شما براشون اهمیت نداره.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eهمیشه فقط به خودشون اهمیت میدن.\u003c/blockquote\u003e",
