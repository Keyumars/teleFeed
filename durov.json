    {
      "id": 0,
      "message": "\u003ctg-emoji emoji-id=\"5388849888098268082\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09FA4A5.png\u0026#39;)\"\u003e\u003cb\u003e🤥\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e WhatsApp’s “encryption” may be the biggest consumer fraud in history — deceiving billions of users. Despite its claims, it reads users’ messages and shares them with third parties. Telegram has never done this — and never will \u003ctg-emoji emoji-id=\"5427127139151397446\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09FA49D.png\u0026#39;)\"\u003e\u003cb\u003e🤝\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e",
      "date": "2026-04-09T21:27:05Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 2,
      "forwards": 0,
      "replies": 0,
      "sender_id": 0,
      "sender_name": "Pavel Durov",
      "media": [
        {
          "type": "photo",
          "url": "https://cdn4.telesco.pe/file/tqjds0BROYTQNZ47uGpaYjB_PjN3lyEGpzJjO7OpuayNySwQVxaZTUlpBAeLbxL_13DJIUChwE-BCENi5-hRw74ux9HQGzvP-QN7ryqgU0WuBH10IKForOo6gHAOp-UUpuKP2VbOKQx61V35jVjl1j39k2x6ptpYF_Rs5OfJ0aEXTOu_Hy5i2pLsVf2jHIZqzk5poAnZXRFa8_-sXEi9akml1chPr9zJs52LEPcD5Tka-TJjRfbYJ5dQBFU1UkqasCjT2tbR9FawUKsOI4OEBmAUst5WwzG5Fexafcc-vXOvQ0PnEw_MPWEV_CiVM0gYLpstAayTgP-FRa2Lcz_x-g.jpg"
        }
